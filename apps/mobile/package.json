{
  "name": "@kechat/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "KeChat Mobile App - iOS & Android built with React Native",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-router": "~3.4.0",
    "react": "^18.3.1",
    "react-native": "~0.73.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "~4.8.0",
    "react-native-screens": "~3.29.0",
    "@tanstack/react-query": "^5.56.2",
    "zustand": "^4.4.7",
    "@kechat/ui": "workspace:*",
    "@kechat/types": "workspace:*",
    "@kechat/sdk-ts": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.3"
  }
}
