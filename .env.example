# KeChat Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# General Configuration
# ============================================
NODE_ENV=development
APP_NAME=KeChat
APP_URL=http://localhost:3000

# ============================================
# Database - PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kechat
POSTGRES_PASSWORD=kechat_dev_password
POSTGRES_DB=kechat

# ============================================
# Cache - Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Message Store - Cassandra
# ============================================
CASSANDRA_HOSTS=localhost:9042
CASSANDRA_KEYSPACE=kechat_messages
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# ============================================
# Message Bus - Kafka
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kechat-dev

# ============================================
# Object Storage - MinIO
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kechat
MINIO_SECRET_KEY=kechat_dev_password
MINIO_BUCKET=kechat-media
MINIO_USE_SSL=false

# ============================================
# Search - OpenSearch
# ============================================
OPENSEARCH_HOST=localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ============================================
# Secrets Management - Vault
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=kechat-dev-token

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# SMS Provider (Africa's Talking / Twilio)
# ============================================
SMS_PROVIDER=africas-talking
SMS_API_KEY=your-api-key
SMS_USERNAME=sandbox
SMS_SENDER_ID=KeChat

# ============================================
# M-Pesa Integration (Daraja API)
# ============================================
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/integrations/mpesa/callback

# ============================================
# Airtel Money Integration
# ============================================
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CLIENT_ID=your-client-id
AIRTEL_CLIENT_SECRET=your-client-secret
AIRTEL_CALLBACK_URL=https://your-domain.com/api/integrations/airtel/callback

# ============================================
# eCitizen Integration
# ============================================
ECITIZEN_ENVIRONMENT=sandbox
ECITIZEN_CLIENT_ID=your-client-id
ECITIZEN_CLIENT_SECRET=your-client-secret
ECITIZEN_REDIRECT_URI=https://your-domain.com/auth/ecitizen/callback

# ============================================
# WebRTC / Calls (LiveKit)
# ============================================
LIVEKIT_HOST=wss://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ============================================
# Monitoring
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=

# ============================================
# Feature Flags
# ============================================
FEATURE_MPESA_ENABLED=true
FEATURE_AIRTEL_ENABLED=false
FEATURE_ECITIZEN_ENABLED=false
FEATURE_CALLS_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_MINIAPPS_ENABLED=false

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf
